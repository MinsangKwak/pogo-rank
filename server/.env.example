# server/.env — 이 파일을 .env 로 복사해 값을 채운다. .env 는 커밋되지 않는다.
# Cloud Run 에서는 같은 이름의 환경변수·시크릿으로 넣는다.

# Postgres 접속 문자열. Neon 은 끝에 ?sslmode=require 가 붙는다
# 로컬: postgres://moncamp:moncamp@localhost:5433/moncamp
#
# **풀링이든 직접이든 하나만 줘도 된다** (v5 Phase 7). 서버가 나머지를 만든다 —
# Neon 은 호스트에 `-pooler` 를 붙여 둘을 가르므로 떼면 직접 주소다.
#   평소 요청   풀링 (인스턴스가 여럿 뜨는 자리라 직접 연결을 아낀다)
#   마이그레이션 직접 (풀러 뒤에서는 세션에 거는 잠금이 안 산다)
DATABASE_URL=

# 둘 다 손으로 주고 싶을 때만. 비우면 위에서 만든다
DATABASE_URL_POOLED=
MIGRATION_DATABASE_URL=

# 수집을 받아 줄 주소. 쉼표로 나눈다. **와일드카드는 못 쓴다**
ALLOWED_ORIGINS=https://moncamp.kr,https://dev.moncamp.kr

# 롤업·진단 엔드포인트의 열쇠. 운영에서는 32자 이상이어야 부팅한다
# 만드는 법: openssl rand -hex 32
ADMIN_TOKEN=

# 한 IP 가 1분에 보낼 수 있는 수집 요청 수 (기본 60)
RATE_LIMIT_PER_MINUTE=60

# Cloud Run 이 넣어 준다. 로컬은 비워 두면 8080
PORT=

# ── 로그인·권한 (v5 Phase 4) ─────────────────────────────────────────────────
# 전부 필수다. 하나라도 비면 부팅에서 죽는다 — 인증이 반쯤 도는 서버를 안 만든다.

# 액세스 토큰 서명 열쇠. **이 값을 아는 사람은 아무 권한의 토큰이든 지어낼 수 있다**
# (구글을 거치지 않고). 비밀번호 관리자에 둔다. 만드는 법: openssl rand -hex 32
JWT_SECRET=

# 이 주소로 로그인하면 언제나 루트 관리자다. 끌어내려져 있어도 로그인에서 되돌아온다 —
# Firestore 규칙 본문에 uid 를 박던 잠금 방지 열쇠를 여기로 옮겼다
ROOT_EMAIL=

# Google Cloud > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID
# 받은 JSON 의 client_id · client_secret 이다. 따옴표와 쉼표는 값이 아니다
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 구글이 인가 코드를 돌려줄 주소. **구글 콘솔의 '승인된 리디렉션 URI' 와 글자까지 같아야 한다.**
# 로컬: http://localhost:8080/v1/auth/google/callback
OAUTH_REDIRECT_URI=https://api.moncamp.kr/v1/auth/google/callback

# 로그인을 마치고 브라우저를 돌려보낼 앱 주소. **ALLOWED_ORIGINS 안에 있어야 한다** —
# 아니면 열린 리다이렉트가 된다(로그인시킨 뒤 남의 사이트로 보내는 길)
APP_ORIGIN=https://moncamp.kr
