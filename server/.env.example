# server/.env — 이 파일을 .env 로 복사해 값을 채운다. .env 는 커밋되지 않는다.
# Cloud Run 에서는 같은 이름의 환경변수·시크릿으로 넣는다.

# Postgres 접속 문자열. Neon 은 끝에 ?sslmode=require 가 붙는다
# 로컬: postgres://moncamp:moncamp@localhost:5433/moncamp
DATABASE_URL=

# 수집을 받아 줄 주소. 쉼표로 나눈다. **와일드카드는 못 쓴다**
ALLOWED_ORIGINS=https://moncamp.kr,https://dev.moncamp.kr

# 롤업·진단 엔드포인트의 열쇠. 운영에서는 32자 이상이어야 부팅한다
# 만드는 법: openssl rand -hex 32
ADMIN_TOKEN=

# 한 IP 가 1분에 보낼 수 있는 수집 요청 수 (기본 60)
RATE_LIMIT_PER_MINUTE=60

# Cloud Run 이 넣어 준다. 로컬은 비워 두면 8080
PORT=
