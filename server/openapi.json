    "/v1/events": {
      "post": {
        "summary": "검색 기록을 보낸다",
        "tags": [
          "수집"
        ],
        "description": "**답을 기다리지 않는 자리다.** 몸통 없이 `204` 만 돌려준다.\n\n- `sendBeacon` 이 보내는 `text/plain` 도 받는다 (프리플라이트가 없어야 탭을 떠나며 보낸 것이 닿는다).\n- `Origin` 을 **서버가 직접 본다** — 허용 목록에 없으면 `403`. CORS 는 단순 요청을 막지 못한다.\n- 모르는 칸이 하나라도 있으면 `400`. 조용히 지우지 않는다.\n- `term` 없는 `search` 처럼 셀 것이 없는 줄은 버리지만, 그래도 `204` 다 — 보낸 쪽이 틀린 게 아니다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "visitor",
                  "events"
                ],
                "additionalProperties": false,
                "properties": {
                  "visitor": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "channel": {
                    "type": "string",
                    "enum": [
                      "prod",
                      "dev"
                    ]
                  },
                  "events": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": {
                      "type": "object",
                      "required": [
                        "name"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "name": {
                          "type": "string",
                          "enum": [
                            "search"
                          ]
                        },
                        "term": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "surface": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 40
                        },
                        "ts": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                }
              }
            },
            "text/plain": {
              "schema": {
                "type": "object",
                "required": [
                  "visitor",
                  "events"
                ],
                "additionalProperties": false,
                "properties": {
                  "visitor": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "channel": {
                    "type": "string",
                    "enum": [
                      "prod",
                      "dev"
                    ]
                  },
                  "events": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": {
                      "type": "object",
                      "required": [
                        "name"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "name": {
                          "type": "string",
                          "enum": [
                            "search"
                          ]
                        },
                        "term": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "surface": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 40
                        },
                        "ts": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "받았다 (걸러져 남은 줄이 없어도 같다)"
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "분당 한도",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "description": "분당 한도"
                }
              }
            }
          }
        }
      }
    },
    "/v1/hot": {
      "get": {
        "summary": "검색 순위",
        "tags": [
          "조회"
        ],
        "description": "**빌드가 받아 가는 자리다, 브라우저가 아니다.** 하루 두 번 도는 배포 워크플로가 받아 정적 파일로 굽는다 —\n그래서 콜드 스타트가 문제되지 않고, 서버가 죽어도 어제 구운 화면이 그대로 선다.\n\n**문턱은 자르기 전에 건다.** 안 그러면 한 사람이 밀어 올린 말들이 열 자리를 다 먹고,\n그 뒤에 전부 걸러져 표가 통째로 빈다.\n\n- 사람당 **하루** `5`회까지만 센다\n- `3`회를 못 넘긴 말, **찾은 사람이 `2`명 미만**인 말은 안 세운다\n- 남은 줄이 `3` 개를 못 채우면 **빈 표**를 준다 — 화면이 구역 자체를 안 그린다\n\n`raw=true` 는 문턱을 끈 날것이라 열쇠가 필요하다.",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 7
            },
            "in": "query",
            "name": "days",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10
            },
            "in": "query",
            "name": "limit",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z]{2}$"
            },
            "in": "query",
            "name": "country",
            "required": false
          },
          {
            "schema": {
              "type": "boolean",
              "default": false
            },
            "in": "query",
            "name": "raw",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "window": {
                      "type": "integer",
                      "description": "센 날 수. 화면이 \"최근 N일\" 이라고 말을 바꾼다"
                    },
                    "country": {
                      "type": "string",
                      "nullable": true
                    },
                    "thresholds": {
                      "type": "object",
                      "description": "`raw` 면 `null`",
                      "properties": {
                        "minHits": {
                          "type": "integer",
                          "description": "이 횟수를 못 넘긴 말은 안 세운다"
                        },
                        "minRows": {
                          "type": "integer",
                          "description": "남은 줄이 이보다 적으면 빈 표를 준다"
                        },
                        "minVisitors": {
                          "type": "integer",
                          "description": "찾은 사람이 이보다 적은 말은 안 세운다"
                        },
                        "personCap": {
                          "type": "integer",
                          "description": "사람당 하루 이 횟수까지만 센다"
                        }
                      },
                      "nullable": true
                    },
                    "generated": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "term": {
                            "type": "string",
                            "description": "고른 완성어"
                          },
                          "hits": {
                            "type": "integer",
                            "description": "사람당 하루 5회까지 센 합계"
                          },
                          "visitors": {
                            "type": "integer",
                            "description": "찾은 사람 수 (난수 ID 기준)"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/rollup": {
      "post": {
        "summary": "일별 집계와 12개월 파기",
        "tags": [
          "관리"
        ],
        "description": "매일 01:30 KST 에 워크플로가 부른다 (`server-rollup.yml`).\n\n1. 최근 며칠을 **다시 세어** `search_daily` 에 굳힌다 — 늦게 도착한 이벤트를 반영한다\n2. **12개월** 넘은 KST 날짜를 먼저 굳히고, 그다음 `events` 에서 지운다\n\n**둘을 한 부름에서 한다.** 파기를 따로 두면 그 워크플로를 빠뜨린 날이 생기고,\n방침에 적은 기간은 누가 기억해서 돌리는 것이 아니라 저절로 지켜져야 한다.\n\n`deleted` 가 0 인 것이 한동안 정상이다 — 첫 12개월은 지울 것이 없다.\n\n3. 만료 하루가 지난 로그인 세션을 지운다 (방침 5번) — `sessions` 가 지운 줄 수다",
        "security": [
          {
            "adminToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "written": {
                      "type": "integer",
                      "description": "다시 센 일별 줄 수"
                    },
                    "purged": {
                      "type": "object",
                      "properties": {
                        "rolled": {
                          "type": "integer",
                          "description": "지우기 전에 굳힌 줄 수"
                        },
                        "deleted": {
                          "type": "integer",
                          "description": "지운 원본 줄 수"
                        },
                        "throughDay": {
                          "type": "string",
                          "description": "이 KST 날짜까지가 대상이었다"
                        }
                      }
                    },
                    "keepMonths": {
                      "type": "integer"
                    },
                    "sessions": {
                      "type": "integer",
                      "description": "지운 만료 세션 줄 수"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/backups": {
      "post": {
        "summary": "백업 한 판을 기록한다",
        "tags": [
          "관리"
        ],
        "description": "주간 백업 워크플로가 암호화본을 올린 **뒤에** 부른다.\n\n**내용물은 안 보낸다.** 잰 수만 온다 — 어디에, 몇 바이트, 해시, 컬렉션별 문서 **수**.\n이름·이메일·트레이너 코드는 오지 않으므로 이 표에는 개인정보가 없다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "location",
                  "bytes",
                  "sha256"
                ],
                "additionalProperties": false,
                "properties": {
                  "location": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500,
                    "description": "`gs://…` 또는 `actions-artifact://…`"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$",
                    "description": "암호화본의 sha256"
                  },
                  "counts": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "ranAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "adminToken": []
          }
        ],
        "responses": {
          "201": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
