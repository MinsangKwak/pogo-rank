                              "type": "integer"
                            },
                            "description": "컬렉션별 문서 수"
                          },
                          "note": {
                            "type": "string",
                            "description": "돌린 워크플로 주소",
                            "nullable": true
                          }
                        }
                      },
                      "description": "최근 열 벌, 최신 순"
                    },
                    "staleDays": {
