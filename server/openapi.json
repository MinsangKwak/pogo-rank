                        },
                        "location": {
                          "type": "string",
                          "description": "`gs://…` 또는 `actions-artifact://…`"
                        },
                        "bytes": {
                          "type": "string"
                        },
                        "sha256": {
                          "type": "string"
                        },
                        "counts": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "integer"
                          },
                          "description": "컬렉션별 문서 수"
                        },
                        "note": {
                          "type": "string",
                          "description": "돌린 워크플로 주소",
                          "nullable": true
                        }
                      },
                      "description": "마지막 한 벌. 한 번도 안 돌았으면 `null`",
                      "nullable": true
                    },
                    "runs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "ran_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "location": {
                            "type": "string",
                            "description": "`gs://…` 또는 `actions-artifact://…`"
                          },
                          "bytes": {
