        ],
        "description": "DB 에 못 닿으면 **503** 이다 — 200 을 주면 Cloud Run 이 죽은 인스턴스에 계속 보낸다.",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
