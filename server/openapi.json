          }
        ],
        "responses": {
          "302": {
            "description": "앱으로"
          }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "summary": "리프레시 쿠키로 액세스 토큰을 받는다",
        "tags": [
          "인증"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access": {
                      "type": "string",
                      "description": "액세스 토큰. 메모리에만 두고 저장소에 안 담는다"
                    },
                    "expiresIn": {
                      "type": "integer",
                      "description": "초"
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "approved",
                        "admin",
                        "root"
                      ]
                    },
                    "beta": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "access",
                    "expiresIn",
                    "role",
                    "beta"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
