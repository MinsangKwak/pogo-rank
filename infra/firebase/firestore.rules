// 2026-09-15 v3.41.0 Firestore 보안 규칙 — Firebase 콘솔 > Firestore Database > 규칙 탭에 **전체 교체**로 붙여넣고 [게시]
//
// 게시할 판은 `bash scripts/render_rules.sh` 가 만드는 firestore.rules.local 이다 —
// 저장소 원본의 자리표시자를 .env 의 ADMIN_UID 로 채운 것이다.
// isRootAdmin() 의 uid 가 채워지지 않은 채로 게시하면 루트 관리자가 사라진다.
//
// 컬렉션
//   allowlist/{email}  승인된 친구. admin: true 가 붙으면 위임 관리자. 가입 승인·해제·관리자 지정 전부 루트만
//   requests/{email}   가입 요청. 본인만 쓰고, 루트만 읽는다
//   users/{uid}        개인 데이터. 본인만. 승인되면 전부(내 포켓몬 포함), 승인 대기면 즐겨찾기까지
//   allowlist/{email}  의 beta: true 는 **실험 기능 참가자** 표식 — admin 과 같은 자리라 루트만 켜고 끈다
//   trainers/{name}    트레이너 코드. 승인된 사람이 읽고, 관리자 둘 다 쓴다
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 2026-09-15 v3.39.0 관리자가 둘로 갈린다.
    //   루트 관리자  : isRootAdmin() 에 박힌 uid 인 사람. 규칙에 있어 누구도 뺏을 수 없다 (잠금 방지용 열쇠)
    //   위임 관리자  : allowlist/{이메일} 문서에 admin: true 가 붙은 사람. 루트가 화면에서 지정한다
    function isRootAdmin() {
      return request.auth != null && request.auth.uid == '__ADMIN_UID__';
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    // exists() 를 먼저 보는 이유 — 문서가 없으면 get() 이 실패한다
    function isDelegatedAdmin() {
      return request.auth != null && request.auth.token.email != null
             && exists(/databases/$(database)/documents/allowlist/$(myEmail()))
             && get(/databases/$(database)/documents/allowlist/$(myEmail())).data.get('admin', false) == true;
    }
    function isAdmin() {
      return isRootAdmin() || isDelegatedAdmin();
    }
    function isApproved() {
      return isAdmin() || (request.auth != null && exists(/databases/$(database)/documents/allowlist/$(myEmail())));
    }

    // 쓰기 한도. 클라이언트의 PLAN_MAX_MONS 검사는 우회되므로 규칙에서 막아야 의미가 있다.
    //
    // ★ 필드 이름을 hasOnly 로 못 박지 않는다. set({merge:true}) 는 request.resource.data 가
    //   **합쳐진 결과**라, 예전 버전이 남긴 필드가 하나라도 목록에 없으면 그 사용자는
    //   그때부터 아무것도 저장하지 못한다. 이름 대신 **개수와 크기**로 막는다.
    function smallDoc(maxKeys, maxListItems) {
      let data = request.resource.data;
      return data.keys().size() <= maxKeys
             && (!('mons' in data) || (data.mons is list && data.mons.size() <= maxListItems))
             && (!('favs' in data) || (data.favs is list && data.favs.size() <= 1000))
             && (!('email' in data) || (data.email is string && data.email.size() <= 320))
             && (!('name' in data) || (data.name is string && data.name.size() <= 200));
    }

    match /allowlist/{mail} {
      // 읽기는 관리자 둘 다 — 위임 관리자는 '유저 관리' 에서 **목록만** 본다
      allow read: if request.auth != null && (isAdmin() || mail == myEmail());
      // 2026-09-15 v3.41.0 **누가 이 서비스를 쓰는가는 루트만 정한다.**
      // v3.39.0 에는 위임 관리자도 가입 승인을 할 수 있었다(admin 필드만 못 건드렸다). 그걸 좁힌다 —
      // 사람을 들이고 내보내는 일은 서비스의 주인이 할 일이고, 위임 관리자는 운영을 돕는 자리다.
      // 위임 관리자가 할 수 있는 일은 trainers 쓰기와 목록 읽기뿐이다.
      allow create, update: if isRootAdmin();
      // 본인 문서 삭제(계정 삭제)는 그대로 — 자기 계정을 스스로 지우는 길은 누구에게나 열려 있어야 한다
      allow delete: if isRootAdmin()
                    || (request.auth != null && mail == myEmail());
    }

    match /requests/{mail} {
      // 2026-09-15 v3.41.0 가입 요청은 **루트만** 본다 — 승인할 수 있는 사람만 읽을 이유가 있다.
      // 위임 관리자 화면에서는 이 조회가 실패하고(코드가 catch 한다) '승인 대기' 칸이 아예 안 그려진다
      allow read: if isRootAdmin();
      allow delete: if isRootAdmin() || (request.auth != null && mail == myEmail());
      // 승인 대기 상태에서 쓸 수 있는 유일한 문서라 여기가 가장 무르다 — 크기를 규칙에서 제한한다
      allow create, update: if request.auth != null && mail == myEmail()
                            && request.resource.data.email == myEmail()
                            && smallDoc(12, 400);
    }

    // 2026-09-17 v3.60.0 승인 대기(pending)도 **즐겨찾기까지는** 담는다.
    //   왜 — 담아 두는 일은 승인을 기다리는 동안에도 할 수 있어야 한다. 승인된 뒤에
    //   "이제 다시 담으세요" 는 말이 안 되고, 담아 둔 것이 있어야 승인을 기다릴 이유도 생긴다.
    //   다만 열어 주는 것은 즐겨찾기 하나뿐이다 — 내 포켓몬(mons)은 개체 300마리라 무게가 다르고,
    //   그 화면 자체가 승인된 사람의 자리다.
    //   승인 전 쓰기 가능한 필드는 email · name · favs · updatedAt 넷이라 키 6개면 넉넉하다.
    function favsOnly() {
      let data = request.resource.data;
      return !('mons' in data)
             && data.keys().size() <= 6
             && (!('favs' in data) || (data.favs is list && data.favs.size() <= 200));
    }

    match /users/{uid} {
      // 2026-09-17 v3.60.0 본인 문서는 승인 여부와 무관하게 읽는다 —
      //   담아 둔 것을 자기가 못 보면 담을 이유가 없다. 남의 문서는 여전히 못 읽는다(uid 일치 검사)
      allow read: if request.auth != null && request.auth.uid == uid;
      // 승인된 사람은 그대로. 개체 300마리는 클라이언트 상한(PLAN_MAX_MONS)과 같은 값이다
      allow create, update: if request.auth != null && request.auth.uid == uid
                            && (isApproved() ? smallDoc(12, 300) : favsOnly());
      // 2026-09-22 v4.9.7 삭제는 따로 둔다 — **본인이면 된다.**
      //   전에는 write 하나로 셋(create·update·delete)을 묶었다. 그런데 삭제 요청에는
      //   request.resource 가 없다(null). smallDoc()·favsOnly() 가 request.resource.data 를
      //   읽는 순간 규칙이 오류로 죽고, 오류는 거부다 — 에뮬레이터가 그대로 찍었다:
      //   "evaluation error at L94 for 'delete' — Null value error".
      //   쓰기 한도가 규칙에 들어온 뒤로 계정 삭제가 users 문서를 한 번도 못 지웠다는 뜻이다.
      //   승인 여부도 안 본다 — 자기 계정을 지우는 길은 승인 대기 중에도 열려 있어야 한다.
      //   frontend-v4/src/test/rules/firestore.rules.test.ts 가 에뮬레이터로 이 셋을 견준다.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /trainers/{name} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }
  }
}
