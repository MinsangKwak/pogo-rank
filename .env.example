# POGO SEARCH 빌드 설정 (2026-09-05 v2.8.0) — 이 파일을 .env 로 복사해 값을 채운다. .env 는 커밋되지 않는다.
# GitHub Actions 에서는 같은 이름의 Repository variables(Settings → Secrets and variables → Actions → Variables)를 쓴다.
# 주의: 여기 값들은 전부 빌드 결과(dist/index.html)에 그대로 들어가 사이트 방문자에게 보인다.
#       비밀이라서가 아니라 "저장소 코드에 운영 식별자를 남기지 않기 위해" 분리한 것이다. 접근 제어는 firestore.rules 가 담당한다.

# GA4 측정 ID (G-XXXXXXXXXX). 비우면 추적 코드가 들어가지 않는다. dev 채널 빌드는 값이 있어도 넣지 않는다
GA_ID=

# 관리자 Firebase uid — 배포 후 ☰ → 🔑 가입 승인 → "내 uid 복사". firestore.rules 의 __ADMIN_UID__ 와 같은 값이어야 한다 (scripts/render_rules.sh 참고)
ADMIN_UID=

# 관리자 이메일 폴백 — ADMIN_UID 가 비어 있을 때만 쓰인다. 보통 비워 둔다
ADMIN_EMAIL=

# 푸터·개인정보처리방침에 표시되는 문의 이메일. 비우면 문의 문구가 빠진다
CONTACT_EMAIL=

# Firebase 콘솔 > 프로젝트 설정 > 내 앱 > firebaseConfig 를 한 줄 JSON 으로. 비우면 로그인 UI 자체가 뜨지 않는다
FIREBASE_CONFIG_JSON={"apiKey":"","authDomain":"","projectId":"","storageBucket":"","messagingSenderId":"","appId":""}
